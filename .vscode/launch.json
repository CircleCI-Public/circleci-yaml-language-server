// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "presentation": {
        "hidden": false,
        "group": "Run",
        "order": 1
      },
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "task: task build",
      "env": {
        "CCI_DEV": "true",
        "TOKEN": "",
        "SELF_HOSTED_URL": ""
      }
    },
    // "Run Extension (attach over IPv4)" starts the extension host paused on a
    // fixed port and attaches to it at 127.0.0.1. "Run Extension" attaches to
    // localhost, which the debugger tries over IPv4 and IPv6 at once; where the
    // IPv6 attempt is refused before IPv4 answers, the attach fails and the
    // extension host never starts.
    {
      "name": "Extension Host (paused on 9333)",
      "presentation": {
        "hidden": true
      },
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--disable-extensions",
        "--inspect-brk-extensions=9333"
      ],
      "env": {
        "CCI_DEV": "true",
        "TOKEN": "",
        "SELF_HOSTED_URL": ""
      }
    },
    {
      "name": "Attach to Extension Host (127.0.0.1:9333)",
      "presentation": {
        "hidden": true
      },
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9333,
      "timeout": 30000,
      // The extension host waits on its first line for the debugger, so that
      // breakpoints are set before activation; this resumes it once they are.
      "continueOnAttach": true,
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"]
    },
    {
      "name": "Run Extension (user extensions enabled)",
      "presentation": {
        "hidden": false,
        "group": "Run",
        "order": 2
      },
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/editors/vscode"],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "task: task build",
      "env": {
        "CCI_DEV": "true"
      }
    },
    {
      "name": "Start server",
      "presentation": {
        "hidden": false,
        "group": "Run",
        "order": 3
      },
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server/main.go",
      "args": [
        "--port",
        "10001"
      ]
    },
    {
      "name": "E2E tests",
      "presentation": {
        "hidden": false,
        "group": "Tests",
        "order": 4
      },
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "E2E tests (standalone)",
      "presentation": {
        "hidden": false,
        "group": "Tests",
        "order": 4
      },
      "env": {
        "SPAWN_LSP_SERVER": "false"
      },
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "Attach to Process",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "start_server"
    }
  ],
  "compounds": [
    {
      "name": "Run Extension (attach over IPv4)",
      "presentation": {
        "hidden": false,
        "group": "Run",
        "order": 1
      },
      "configurations": [
        "Extension Host (paused on 9333)",
        "Attach to Extension Host (127.0.0.1:9333)"
      ],
      "preLaunchTask": "task: task build",
      "stopAll": true
    }
  ]
}
